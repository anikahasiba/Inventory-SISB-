@using SISB.Entities
@model List<Category>
@{
    Layout = "_PrivateLayout";
    ViewData["Title"] = "Categories";
}

<link rel="stylesheet" href="~/css/Admin/Category.css" asp-append-version="true" />

<div class="ct">

    <header class="ct-top">
        <div>
            <h2>Categories</h2>
            <p>7 categories · 8 sub-categories · 120 active products</p>
        </div>
        <button class="ct-btn" type="button" data-open="add">Add category</button>
    </header>

    <form class="ct-card ct-filters" role="search" aria-label="Filter categories" onsubmit="return false">
        <label class="ct-field">
            Search
            <input type="search" placeholder="Category or sub-category name">
        </label>
        <label class="ct-check"><input type="checkbox"> Show inactive</label>
    </form>

    <section class="ct-card">
        <div class="ct-wrap">
            <table class="ct-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Parent</th>
                        <th class="ct-num">Products</th>
                        <th class="ct-num">Need attention</th>
                        <th class="ct-num">Stock value</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="ct-parent">
                        <td>Rice and grains<small>3 sub-categories</small></td>
                        <td class="ct-zero">Top level</td>
                        <td class="ct-num">22</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">3</span></td>
                        <td class="ct-num">৳3,60,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Rice and grains">Edit</button><button class="ct-link" type="button" data-open="sub" data-parent="Rice and grains">Add sub-category</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-child">
                        <td>Basmati rice</td>
                        <td>Rice and grains</td>
                        <td class="ct-num">8</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">2</span></td>
                        <td class="ct-num">৳1,80,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Basmati rice">Edit</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-child">
                        <td>Miniket rice</td>
                        <td>Rice and grains</td>
                        <td class="ct-num">9</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">1</span></td>
                        <td class="ct-num">৳1,35,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Miniket rice">Edit</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-child ct-last">
                        <td>Flour and atta</td>
                        <td>Rice and grains</td>
                        <td class="ct-num">5</td>
                        <td class="ct-num ct-zero">0</td>
                        <td class="ct-num">৳45,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Flour and atta">Edit</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>

                    <tr class="ct-parent">
                        <td>Cooking oil</td>
                        <td class="ct-zero">Top level</td>
                        <td class="ct-num">9</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">2</span></td>
