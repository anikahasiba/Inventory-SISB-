@using SISB.Entities
@model List<Category>

@{
    Layout = "_PrivateLayout";
    ViewData["Title"] = "Categories";
}

<link rel="stylesheet"
      href="~/css/Admin/Category.css"
      asp-append-version="true" />

<div class="category-page">

    <div class="category-header">
        <div>
            <h2>Categories</h2>
            <p>Manage all your product categories.</p>
        </div>

        <a asp-controller="Category"
           asp-action="Create"
           class="btn-add">
            <span>+</span> Add Category
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="category-toolbar">
        <form asp-action="Index" method="get">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search category..." />

            <button type="submit">Search</button>

            <a asp-action="Index" class="reset-btn">
                Reset
            </a>
        </form>
    </div>

    <div class="category-table-wrapper">
        <table class="category-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Category Name</th>
                    <th>Parent Category</th>
                    <th>Subcategories</th>
                    <th>Total Products</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryId</td>

                            <td>
                                <strong>@category.Name</strong>
                            </td>

                            <td>
                                @if (category.ParentCategory != null)
                                {
                                    <span class="parent-label">
                                        @category.ParentCategory.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="root-label">
                                        Main Category
                                    </span>
                                }
                            </td>

                            <td>
                                @category.SubCategories.Count
                            </td>

                            <td>
                                @category.Products.Count
                            </td>

                            <td>
                                <div class="category-actions">
                                    <a asp-action="Edit"
                                       asp-route-id="@category.CategoryId"
                                       class="edit-btn">
                                        Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-row">
                            No categories found in database.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="category-footer-note">
        Categories with products cannot be deleted.
        Categories with subcategories must have their subcategories
        moved first.
    </p>

</div>
