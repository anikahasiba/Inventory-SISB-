                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Cooking oil">Edit</button><button class="ct-link" type="button" data-open="sub" data-parent="Cooking oil">Add sub-category</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-parent">
                        <td>Pulses</td>
                        <td class="ct-zero">Top level</td>
