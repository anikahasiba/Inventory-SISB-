                        <td class="ct-num"><span class="ct-pill ct-warn">3</span></td>
                        <td class="ct-num">৳1,60,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Pulses">Edit</button><button class="ct-link" type="button" data-open="sub" data-parent="Pulses">Add sub-category</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-parent">
                        <td>Dairy</td>
                        <td class="ct-zero">Top level</td>
                        <td class="ct-num">14</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">3</span></td>
                        <td class="ct-num">৳2,35,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Dairy">Edit</button><button class="ct-link" type="button" data-open="sub" data-parent="Dairy">Add sub-category</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-parent">
                        <td>Sugar and salt</td>
                        <td class="ct-zero">Top level</td>
                        <td class="ct-num">8</td>
                        <td class="ct-num ct-zero">0</td>
                        <td class="ct-num">৳90,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Sugar and salt">Edit</button><button class="ct-link" type="button" data-open="sub" data-parent="Sugar and salt">Add sub-category</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>

                    <tr class="ct-parent">
                        <td>Snacks<small>3 sub-categories</small></td>
                        <td class="ct-zero">Top level</td>
                        <td class="ct-num">31</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">2</span></td>
                        <td class="ct-num">৳1,02,500</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Snacks">Edit</button><button class="ct-link" type="button" data-open="sub" data-parent="Snacks">Add sub-category</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-child">
                        <td>Biscuits</td>
                        <td>Snacks</td>
                        <td class="ct-num">14</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">1</span></td>
                        <td class="ct-num">৳52,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Biscuits">Edit</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-child">
                        <td>Chips</td>
