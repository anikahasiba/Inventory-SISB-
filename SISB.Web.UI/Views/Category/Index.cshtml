                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Chips">Edit</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-child ct-last">
                        <td>Chocolate</td>
                        <td>Snacks</td>
                        <td class="ct-num">6</td>
                        <td class="ct-num ct-zero">0</td>
                        <td class="ct-num">৳12,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Chocolate">Edit</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>

                    <tr class="ct-parent">
                        <td>Stationery<small>2 sub-categories</small></td>
                        <td class="ct-zero">Top level</td>
                        <td class="ct-num">20</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">1</span></td>
                        <td class="ct-num">৳92,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Stationery">Edit</button><button class="ct-link" type="button" data-open="sub" data-parent="Stationery">Add sub-category</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-child">
                        <td>Notebooks</td>
                        <td>Stationery</td>
                        <td class="ct-num">12</td>
                        <td class="ct-num"><span class="ct-pill ct-warn">1</span></td>
                        <td class="ct-num">৳58,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Notebooks">Edit</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr class="ct-child ct-last">
                        <td>Pens</td>
                        <td>Stationery</td>
                        <td class="ct-num">8</td>
                        <td class="ct-num ct-zero">0</td>
                        <td class="ct-num">৳34,000</td>
                        <td><span class="ct-pill ct-ok">Active</span></td>
                        <td><div class="ct-actions"><button class="ct-link" type="button" data-open="edit" data-name="Pens">Edit</button><button class="ct-link ct-danger" type="button">Deactivate</button></div></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="ct-foot">Categories that have products can be deactivated but not deleted, and a category with sub-categories needs them moved first.</p>
    </section>

    <dialog id="cat-dialog" class="ct-dialog" aria-labelledby="cat-title">
        <form method="dialog">
            <h3 id="cat-title">Add category</h3>
            <p class="ct-sub">Use a parent category to make this a sub-category.</p>
            <div class="ct-fgrid">
                <label class="ct-field">Category name<input type="text" id="cat-name" required></label>
                <label class="ct-field">
                    Parent category
                    <select id="cat-parent">
                        <option value="">None (top-level category)</option>
                        <option>Rice and grains</option>
                        <option>Cooking oil</option>
                        <option>Pulses</option>
                        <option>Dairy</option>
                        <option>Sugar and salt</option>
                        <option>Snacks</option>
                        <option>Stationery</option>
                    </select>
                    <span class="ct-hint">A sub-category cannot have its own sub-categories.</span>
                </label>
                <label class="ct-check"><input type="checkbox" checked> Active</label>
            </div>
            <div class="ct-dfoot">
                <button class="ct-btn ct-btn-ghost" value="cancel">Cancel</button>
                <button class="ct-btn" value="save">Save category</button>
            </div>
        </form>
    </dialog>

</div>

<script>
    (function () {
        var dlg = document.getElementById('cat-dialog');
        var title = document.getElementById('cat-title');
        var name = document.getElementById('cat-name');
        var parent = document.getElementById('cat-parent');
        document.querySelectorAll('[data-open]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var mode = btn.dataset.open;
                title.textContent = mode === 'edit' ? 'Edit category' : (mode === 'sub' ? 'Add sub-category' : 'Add category');
                name.value = mode === 'edit' ? btn.dataset.name : '';
                parent.value = mode === 'sub' ? btn.dataset.parent : '';
                dlg.showModal();
            });
        });
    })();
</script>
