@using SISB.Entities
@model List<Customer>

@{
    Layout = "_PrivateLayout";
    ViewData["Title"] = "Customers";
}

<link rel="stylesheet"
      href="~/css/Admin/Customer.css"
      asp-append-version="true" />

<div class="cu">

    <!-- HEADER -->
    <header class="cu-top">
        <div>
            <h2>Customers</h2>
            <p>
                @ViewBag.ActiveCustomers active customers ·
                @Model.Count(c => c.DueBalance > 0) have an unpaid balance
            </p>
        </div>

        <a asp-controller="Customer"
           asp-action="Create"
           class="cu-btn">
            + Add customer
        </a>
    </header>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="cu-success">
            @TempData["Success"]
        </div>
    }

    <!-- SUMMARY CARDS -->
    <section class="cu-stats">

        <div class="cu-card cu-stat cu-due">
            <span>Total dues</span>

            <strong>
                ৳@(((decimal)ViewBag.TotalDues).ToString("N0"))
            </strong>

            <em>Outstanding customer balances</em>
        </div>

        <div class="cu-card cu-stat cu-risk">
            <span>Near credit limit</span>

            <strong>@ViewBag.NearCreditLimit</strong>

            <em>At 80% or more of their limit</em>
        </div>

        <div class="cu-card cu-stat">
            <span>Credit given</span>

            <strong>
                ৳@(((decimal)ViewBag.CreditGiven).ToString("N0"))
            </strong>

            <em>Total of all credit limits</em>
        </div>

    </section>

    <!-- SEARCH -->
    <form asp-controller="Customer"
          asp-action="Index"
          method="get"
          class="cu-card cu-filters">

        <div class="cu-search">
            <label for="search">Search</label>

            <input id="search"
                   type="search"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Customer name or phone" />
        </div>

        <button type="submit" class="cu-btn cu-search-btn">
            Search
        </button>

        <a asp-action="Index" class="cu-reset">
            Reset
        </a>

    </form>

    <!-- CUSTOMER TABLE -->
    <section class="cu-card cu-table-card">

        <div class="cu-wrap">

            <table class="cu-table">

                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Credit limit</th>
                        <th>Due balance</th>
                        <th>Credit used</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var customer in Model)
                        {
                            var percentage = customer.CreditLimit > 0
                                ? Math.Min(
                                    100,
                                    (double)(customer.DueBalance /
                                    customer.CreditLimit * 100))
                                : 0;

                            var initials = string.Join(
                                "",
                                customer.Name
                                    .Split(
                                        ' ',
                                        StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(x => x.Substring(0, 1).ToUpper()));

                            <tr>

                                <!-- CUSTOMER -->
                                <td>
                                    <div class="cu-name">

                                        <span class="cu-avatar">
                                            @initials
                                        </span>

                                        <div>
                                            <b>@customer.Name</b>

                                            <small>
                                                @(string.IsNullOrWhiteSpace(customer.Address)
                                                    ? "No address"
                                                    : customer.Address)
                                            </small>
                                        </div>

                                    </div>
                                </td>

                                <!-- PHONE -->
                                <td>
                                    @(customer.Phone ?? "N/A")
                                </td>

                                <!-- CREDIT LIMIT -->
                                <td class="cu-num">
                                    ৳@customer.CreditLimit.ToString("N0")
                                </td>

                                <!-- DUE BALANCE -->
                                <td class="cu-num">
                                    <span class="cu-due-amount">
                                        ৳@customer.DueBalance.ToString("N0")
                                    </span>
                                </td>

                                <!-- CREDIT USAGE -->
                                <td>
                                    <div class="cu-meter">

                                        <div class="cu-track">
                                            <i style="width: @(percentage)%"
                                               class="@(percentage >= 100
                                                    ? "cu-meter-danger"
                                                    : percentage >= 80
                                                        ? "cu-meter-warning"
                                                        : "")">
                                            </i>
                                        </div>

                                        <span>
                                            @percentage.ToString("N0")%
                                        </span>

                                    </div>
                                </td>

                                <!-- STATUS -->
                                <td>
                                    @if (!customer.IsActive)
                                    {
                                        <span class="cu-pill cu-inactive">
                                            Inactive
                                        </span>
                                    }
                                    else if (customer.CreditLimit > 0 &&
                                             customer.DueBalance >= customer.CreditLimit)
                                    {
                                        <span class="cu-pill cu-limit">
                                            Limit reached
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cu-pill cu-active">
                                            Active
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td>
                                    <div class="cu-actions">

                                        <a asp-controller="Customer"
                                           asp-action="Edit"
                                           asp-route-id="@customer.CustomerId"
                                           class="cu-action-edit">
                                            Edit
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="cu-empty">
                                No customers found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="cu-foot">
            Customer due balance is maintained through sales and payments.
        </div>

    </section>

</div>