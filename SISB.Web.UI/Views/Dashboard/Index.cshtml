@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_PrivateLayout";
}
<!-- SUMMARY CARDS -->
<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span class="stat-label">Today's Sales</span>
                <div class="stat-icon" style="background:#e8f0ff;color:#4778db">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
            <div class="stat-number">৳ 25,450</div>
            <div class="stat-note"><i class="bi bi-arrow-up"></i> Today's revenue</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span class="stat-label">Today's Profit</span>
                <div class="stat-icon" style="background:#e2f7ed;color:#159568">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
            <div class="stat-number">৳ 6,250</div>
            <div class="stat-note">Estimated daily profit</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span class="stat-label">Low Stock Items</span>
                <div class="stat-icon" style="background:#fff2d9;color:#d99a25">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
            <div class="stat-number">12</div>
            <div class="stat-note" style="color:#c68a19">Needs attention</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span class="stat-label">Stock Value</span>
                <div class="stat-icon" style="background:#f1eaff;color:#8c5bd6">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <div class="stat-number">৳ 4,85,000</div>
            <div class="stat-note">Current inventory value</div>
        </div>
    </div>

</div>

<!-- SALES CHART AND ALERTS -->
<div class="row g-3 mb-4">

    <div class="col-lg-8">
        <div class="panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="panel-title mb-0">Sales Overview</div>
                <span class="badge bg-light text-dark">Last 30 Days</span>
            </div>
            <canvas id="salesChart" height="115"></canvas>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel">
            <div class="panel-title">Stock Alerts</div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div><i class="bi bi-exclamation-circle text-warning me-2"></i>Low Stock</div>
                <span class="status warning">12 Items</span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div><i class="bi bi-x-circle text-danger me-2"></i>Out of Stock</div>
                <span class="status danger">4 Items</span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div><i class="bi bi-calendar-x text-warning me-2"></i>Expiring Soon</div>
                <span class="status warning">6 Items</span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div><i class="bi bi-hourglass-split text-secondary me-2"></i>Dead Stock</div>
                <span class="status danger">3 Items</span>
            </div>

            <a href="/Stock/Index" class="btn btn-outline-success btn-sm w-100 mt-2">
                View All Alerts
            </a>
        </div>
    </div>

</div>

<!-- PRODUCTS AND RECENT SALES -->
<div class="row g-3 mb-4">

    <div class="col-lg-7">
        <div class="panel">
            <div class="d-flex justify-content-between align-items-center">
                <div class="panel-title">Top 5 Selling Products</div>
                <a href="/Report/Index" class="small text-success">View Report</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>SKU</th>
                            <th>Sold</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Rice</td><td>SKU001</td><td>150 kg</td><td>৳12,000</td></tr>
                        <tr><td>Cooking Oil</td><td>SKU002</td><td>85 pcs</td><td>৳10,200</td></tr>
                        <tr><td>Sugar</td><td>SKU003</td><td>70 kg</td><td>৳7,000</td></tr>
                        <tr><td>Milk</td><td>SKU004</td><td>60 pcs</td><td>৳4,800</td></tr>
                        <tr><td>Soap</td><td>SKU005</td><td>55 pcs</td><td>৳3,300</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel">
            <div class="panel-title">Recent Sales</div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Invoice</th><th>Amount</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>#INV-1025</td><td>৳2,500</td><td><span class="status success">Paid</span></td></tr>
                        <tr><td>#INV-1024</td><td>৳1,800</td><td><span class="status success">Paid</span></td></tr>
                        <tr><td>#INV-1023</td><td>৳3,200</td><td><span class="status warning">Due</span></td></tr>
                        <tr><td>#INV-1022</td><td>৳950</td><td><span class="status success">Paid</span></td></tr>
                    </tbody>
                </table>
            </div>
            <a href="/Sales/Index" class="small text-success">View All Sales →</a>
        </div>
    </div>

</div>

<!-- SMART REORDER AND QUICK ACTIONS -->
<div class="row g-3">

    <div class="col-lg-7">
        <div class="panel">
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="ai-icon"><i class="bi bi-robot"></i></div>
                <div>
                    <div class="panel-title mb-0">AI Smart Reorder</div>
                    <small class="text-secondary">Intelligent stock recommendations</small>
                </div>
            </div>

            <div class="ai-box">
                <strong>Rice (SKU001)</strong>
                <p class="small text-secondary mb-2">
                    Current stock is below the predicted reorder point.
                </p>
                <div class="row small mb-3">
                    <div class="col-4">Current Stock<br><strong>25 kg</strong></div>
                    <div class="col-4">Suggested Order<br><strong>95 kg</strong></div>
                    <div class="col-4">Confidence<br><span class="status success">High</span></div>
                </div>
                <a href="/Forecast/Index" class="btn btn-success btn-sm">
                    View Smart Reorder
                </a>
            </div>

        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel">
            <div class="panel-title">Quick Actions</div>
            <div class="row g-2">
                <div class="col-4">
                    <a class="quick-link" href="/Product/Create">
                        <i class="bi bi-plus-circle"></i>Add Product
                    </a>
                </div>
                <div class="col-4">
                    <a class="quick-link" href="/Sales/Create">
                        <i class="bi bi-cart-check"></i>New Sale
                    </a>
                </div>
                <div class="col-4">
                    <a class="quick-link" href="/Purchase/Create">
                        <i class="bi bi-truck"></i>New Purchase
                    </a>
                </div>
                <div class="col-4">
                    <a class="quick-link" href="/Stock/Index">
                        <i class="bi bi-boxes"></i>Stock
                    </a>
                </div>
                <div class="col-4">
                    <a class="quick-link" href="/Report/Index">
                        <i class="bi bi-file-earmark-bar-graph"></i>Reports
                    </a>
                </div>
                <div class="col-4">
                    <a class="quick-link" href="/Assistant/Index">
                        <i class="bi bi-robot"></i>AI Chat
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>