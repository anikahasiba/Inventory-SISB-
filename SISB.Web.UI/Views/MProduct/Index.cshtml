                        <td><div class="mp-prod"><span class="mp-thumb" aria-hidden="true">SO</span><div><b>Soybean oil 5L</b><small>SKU OL-0004 · 8901234500246</small></div></div></td>
                        <td>Cooking oil</td>
                        <td>Meghna Traders</td>
                        <td class="mp-num">৳840</td>
                        <td class="mp-num">৳915</td>
