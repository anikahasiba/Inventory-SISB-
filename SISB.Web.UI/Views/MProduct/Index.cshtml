@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="~/css/Manager/Mproduct.css" asp-append-version="true" />

<div class="mp">

    <header class="mp-top">
        <div>
            <h2>Products</h2>
            <p>120 active products · 14 need attention</p>
        </div>
        <div class="mp-tools">
            <button class="mp-btn mp-btn-ghost" type="button" id="mp-open-import">Import CSV or Excel</button>
            <button class="mp-btn" type="button" id="mp-open-add">Add product</button>
        </div>
    </header>

    <form class="mp-card mp-filters" role="search" aria-label="Filter products" onsubmit="return false">
        <label class="mp-field">
            Search
            <input type="search" id="mp-q" placeholder="Name, SKU or barcode">
        </label>
        <label class="mp-field">
            Category
            <select id="mp-cat"><option value="">All categories</option><option>Rice and grains</option><option>Cooking oil</option><option>Pulses</option><option>Dairy</option><option>Sugar and salt</option><option>Snacks</option><option>Stationery</option></select>
        </label>
        <label class="mp-field">
            Stock status
            <select id="mp-status"><option value="">All</option><option value="healthy">Healthy</option><option value="low">Low stock</option><option value="out">Out of stock</option></select>
        </label>
        <label class="mp-check"><input type="checkbox" id="mp-inactive"> Show inactive</label>
    </form>

    <section class="mp-card">
        <div class="mp-wrap">
            <table class="mp-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Supplier</th>
                        <th class="mp-num">Buy price</th>
                        <th class="mp-num">Sell price</th>
                        <th class="mp-num">In stock</th>
                        <th class="mp-num">Reorder at</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="mp-body">
                    <tr data-name="Basmati rice 5kg" data-sku="RC-0012" data-barcode="8901234500123" data-cat="Rice and grains" data-unit="kg" data-buy="640" data-sell="720" data-supplier="Karim Wholesale" data-expiry="no" data-reorder="50" data-src="auto" data-status="low" data-active="yes">
                        <td><div class="mp-prod"><span class="mp-thumb" aria-hidden="true">BR</span><div><b>Basmati rice 5kg</b><small>SKU RC-0012 · 8901234500123</small></div></div></td>
                        <td>Rice and grains</td>
                        <td>Karim Wholesale</td>
                        <td class="mp-num">৳640</td>
                        <td class="mp-num">৳720</td>
                        <td class="mp-num"><span class="mp-stock mp-warn">25</span> bags</td>
                        <td class="mp-num">50<span class="mp-src">Automatic</span></td>
                        <td><span class="mp-pill mp-warn">Low stock</span></td>
                        <td><div class="mp-actions"><button class="mp-link mp-edit" type="button">Edit</button><button class="mp-link mp-danger" type="button">Deactivate</button></div></td>
                    </tr>
