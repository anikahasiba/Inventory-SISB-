                        <td><div class="mp-actions"><button class="mp-link mp-edit" type="button">Edit</button><button class="mp-link mp-danger" type="button">Deactivate</button></div></td>
                    </tr>
                    <tr data-name="Sugar 1kg" data-sku="SG-0001" data-barcode="8901234500369" data-cat="Sugar and salt" data-unit="kg" data-buy="118" data-sell="130" data-supplier="Karim Wholesale" data-expiry="no" data-reorder="90" data-src="auto" data-status="healthy" data-active="yes">
