@using SISB.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@model Product

@{
    Layout = "_PrivateLayout";
    ViewData["Title"] = "Edit Product";
}

<link rel="stylesheet" href="~/css/Admin/Product.css"
      asp-append-version="true" />

<div class="pr">

    <header class="pr-top">
        <div>
            <h2>Edit Product</h2>
            <p>Update product information.</p>
        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="pr-btn pr-btn-ghost">
            Back to Products
        </a>
    </header>

    <section class="pr-card">

        <form asp-controller="Product"
              asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="ProductId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="pr-fgrid">

                <!-- PRODUCT NAME -->
                <label class="pr-field pr-wide">
                    Product Name

                    <input asp-for="Name"
                           type="text"
                           placeholder="Enter product name" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </label>

                <!-- SKU -->
                <label class="pr-field">
                    SKU

                    <input asp-for="SKU"
                           type="text"
                           placeholder="Enter SKU" />

                    <span asp-validation-for="SKU"
                          class="text-danger"></span>
                </label>

                <!-- BARCODE -->
                <label class="pr-field">
                    Barcode

                    <input asp-for="Barcode"
                           type="text"
                           placeholder="Enter barcode" />

                    <span asp-validation-for="Barcode"
                          class="text-danger"></span>
                </label>

                <!-- CATEGORY -->
                <label class="pr-field">
                    Category

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.Categories">
                        <option value="">Select category</option>
                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger"></span>
                </label>

                <!-- UNIT -->
                <label class="pr-field">
                    Unit

                    <select asp-for="Unit">
                        <option value="">Select unit</option>
                        <option value="pcs">Pieces</option>
                        <option value="kg">Kilogram</option>
                        <option value="box">Box</option>
                        <option value="liter">Liter</option>
                        <option value="packet">Packet</option>
                    </select>

                    <span asp-validation-for="Unit"
                          class="text-danger"></span>
                </label>

                <!-- PURCHASE PRICE -->
                <label class="pr-field">
                    Purchase Price (৳)

                    <input asp-for="PurchasePrice"
                           type="number"
                           min="0"
                           step="0.01" />

                    <span asp-validation-for="PurchasePrice"
                          class="text-danger"></span>
                </label>

                <!-- SELLING PRICE -->
                <label class="pr-field">
                    Selling Price (৳)

                    <input asp-for="SellingPrice"
                           type="number"
                           min="0"
                           step="0.01" />

                    <span asp-validation-for="SellingPrice"
                          class="text-danger"></span>
                </label>

                <!-- REORDER LEVEL -->
                <label class="pr-field">
                    Reorder Level

                    <input asp-for="ReorderLevel"
                           type="number"
                           min="0"
                           step="0.001" />

                    <span asp-validation-for="ReorderLevel"
                          class="text-danger"></span>
                </label>

                <!-- PREFERRED SUPPLIER -->
                <label class="pr-field">
                    Preferred Supplier

                    <select asp-for="PreferredSupplierId"
                            asp-items="ViewBag.Suppliers">
                        <option value="">Select supplier</option>
                    </select>

                    <span asp-validation-for="PreferredSupplierId"
                          class="text-danger"></span>
                </label>

                <!-- WAC -->
                <label class="pr-field">
                    Weighted Average Cost (WAC)

                    <input asp-for="WAC"
                           type="number"
                           min="0"
                           step="0.01" />

                    <span asp-validation-for="WAC"
                          class="text-danger"></span>
                </label>

                <!-- IMAGE URL -->
                <label class="pr-field pr-wide">
                    Image URL

                    <input asp-for="ImageUrl"
                           type="text"
                           placeholder="Enter product image URL" />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger"></span>
                </label>

                <!-- EXPIRY TRACKING -->
                <label class="pr-check pr-wide">
                    <input asp-for="IsExpiryTracked"
                           type="checkbox" />
                    Track expiry dates
                </label>

                <!-- ACTIVE STATUS -->
                <label class="pr-check pr-wide">
                    <input asp-for="IsActive"
                           type="checkbox" />
                    Active Product
                </label>

            </div>

            <div class="pr-dfoot">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="pr-btn pr-btn-ghost">
                    Cancel
                </a>

                <button type="submit" class="pr-btn">
                    Update Product
                </button>

            </div>

        </form>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
