@using SISB.Entities
@model ProductSupplierCategory
@{
    Layout = "_PrivateLayout";
    ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="~/css/Admin/Product.css" asp-append-version="true" />

<div class="pr">

    <header class="pr-top">
        <div>
            <h2>Products</h2>
            <p>@ViewBag.ActiveProductCount active products · @ViewBag.NeedAttentions need attention</p>
        </div>
        <div class="pr-tools">
            <button class="pr-btn pr-btn-ghost" type="button">Import CSV or Excel</button>
            <a asp-controller="Product" asp-action="Create"> <button class="pr-btn" type="button" id="open-add">Add product</button></a>
        </div>
    </header>

    

    <section class="pr-card">
        <div class="pr-table-wrap">
            <table class="pr-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Supplier</th>
                        <th class="pr-num">Buy price</th>
                        <th class="pr-num">Sell price</th>
                        <th class="pr-num">In stock</th>
                        <th class="pr-num">Reorder at</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                   
                    @foreach(var product in Model.product)
                    {
                     <tr>
                       
                            
                        <td><div class="pr-prod"><span class="pr-thumb" aria-hidden="true">SO</span><div><b>@product.Name</b><small>@product.SKU</small></div></div></td>
                            <td>
                                @{
                                    var CategoryName = Model.category
                                        .Where(c => c.CategoryId == product.CategoryId)
                                        .Select(c => c.Name)
                                        .FirstOrDefault();
                                }

                                @CategoryName
                        </td>
                            <td>@{
                                    var SupplierName = Model.supplier.Where(s => s.SupplierId == product.PreferredSupplierId).Select(s => s.Name).FirstOrDefault();
                            }
                            @SupplierName
                        </td>
                        <td class="pr-num">৳@product.PurchasePrice</td>
                        <td class="pr-num">৳@product.SellingPrice</td>
                        <td class="pr-num"><span class="pr-stock pr-warn">@product.StockCount</span></td>
                        <td class="pr-num">@product.ReorderLevel</td>
                        <td><span class="pr-pill pr-warn">
                                            @{
                                                if (product.StockCount == 0)
                                                {
                                                    @:Out of Stock
                                                }
                                                else if (product.StockCount <= product.ReorderLevel)
                                                {
                                                    @:Low Stock
                                                }
                                                else
                                                {
                                                    @:In Stock
                                                }
                                            }
                        </span></td>
                        
                            <td><div class="pr-actions"><button class="pr-link" type="button">
                                <a asp-action="Edit" asp-controller="Product" asp-route-id="@product.ProductId">Edit</a>
                                </button><button class="pr-link pr-danger" type="button">
                                    Deactivate</button></div>
                                </td>
                    </tr>
                    }
                   
                </tbody>
            </table>
        </div>
        <div class="pr-foot">
            <span>Showing 1–7 of 120 products. Products with stock history can be deactivated but not deleted.</span>
            <div class="pr-pager" aria-label="Pages">
                <button type="button" aria-label="Previous page">‹</button>
                <button type="button" aria-current="page">1</button>
                <button type="button">2</button>
                <button type="button">3</button>
                <button type="button" aria-label="Next page">›</button>
            </div>
        </div>
    </section>

    <dialog id="add-dialog" class="pr-dialog" aria-labelledby="add-title">
        <form method="dialog">
            <h3 id="add-title">Add product</h3>
            <p class="pr-sub">Leave SKU empty and SmartStock will generate one.</p>
            <div class="pr-fgrid">
                <label class="pr-field pr-wide">Product name<input type="text" required></label>
                <label class="pr-field">SKU<input type="text" placeholder="Auto-generated"></label>
                <label class="pr-field">Barcode<input type="text" inputmode="numeric"></label>
                <label class="pr-field">
                    Category
                    <select><option>Rice and grains</option><option>Cooking oil</option><option>Pulses</option><option>Dairy</option><option>Sugar and salt</option><option>Snacks</option><option>Stationery</option></select>
                </label>
                <label class="pr-field">
                    Unit
                    <select><option>pcs</option><option>kg</option><option>box</option></select>
                </label>
                <label class="pr-field">Purchase price (৳)<input type="number" min="0" step="0.01" required></label>
                <label class="pr-field">Selling price (৳)<input type="number" min="0" step="0.01" required></label>
                <label class="pr-field">
                    Reorder level
                    <input type="number" min="0">
                    <span class="pr-hint">Leave empty to use the AI-calculated level once there is enough sales data.</span>
                </label>
                <label class="pr-field">
                    Preferred supplier
                    <select><option>Karim Wholesale</option><option>Meghna Traders</option><option>Dhaka Dairy Supply</option><option>Paper Point</option></select>
                </label>
                <label class="pr-field pr-wide">Product image<input type="file" accept="image/*"></label>
                <label class="pr-check pr-wide"><input type="checkbox"> Track expiry dates (stock is held in batches)</label>
            </div>
            <div class="pr-dfoot">
                <button class="pr-btn pr-btn-ghost" value="cancel">Cancel</button>
                <button class="pr-btn" value="save">Save product</button>
            </div>
        </form>
    </dialog>

</div>


