    <dialog id="sa-dialog" class="sa-dialog" aria-labelledby="sa-title">
        <form method="dialog">
            <h3 id="sa-title">New sale</h3>
            <p class="sa-sub">Tap a product to add it. Stock is checked as you go.</p>

            <div class="sa-pos">
                <div>
                    <label class="sa-field">
                        Find a product
                        <input type="search" id="sa-find" placeholder="Name, SKU or barcode">
                    </label>
                    <div class="sa-catalog" id="sa-catalog">
                        <button type="button" class="sa-prod" data-name="Basmati rice 5kg" data-price="720" data-cost="640" data-stock="25"><div><b>Basmati rice 5kg</b><small class="sa-low">25 in stock</small></div><span>৳720</span></button>
                        <button type="button" class="sa-prod" data-name="Soybean oil 5L" data-price="915" data-cost="840" data-stock="18"><div><b>Soybean oil 5L</b><small class="sa-low">18 in stock</small></div><span>৳915</span></button>
                        <button type="button" class="sa-prod" data-name="Sugar 1kg" data-price="130" data-cost="118" data-stock="240"><div><b>Sugar 1kg</b><small>240 in stock</small></div><span>৳130</span></button>
                        <button type="button" class="sa-prod" data-name="Red lentils 1kg" data-price="145" data-cost="125" data-stock="12"><div><b>Red lentils 1kg</b><small class="sa-low">12 in stock</small></div><span>৳145</span></button>
                        <button type="button" class="sa-prod" data-name="Powdered milk 500g" data-price="460" data-cost="410" data-stock="0" disabled><div><b>Powdered milk 500g</b><small class="sa-none">Out of stock</small></div><span>৳460</span></button>
                        <button type="button" class="sa-prod" data-name="Cream biscuits 200g" data-price="40" data-cost="32" data-stock="180"><div><b>Cream biscuits 200g</b><small>180 in stock</small></div><span>৳40</span></button>
                        <button type="button" class="sa-prod" data-name="Notebook A4 200 pages" data-price="95" data-cost="70" data-stock="48"><div><b>Notebook A4 200 pages</b><small>48 in stock</small></div><span>৳95</span></button>
                    </div>
                </div>

                <div>
                    <h4>Current sale</h4>
                    <div class="sa-cart" id="sa-cart"><p class="sa-empty" id="sa-empty">No products yet.</p></div>

