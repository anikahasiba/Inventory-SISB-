</div>

<script>
    (function () {
        var dlg = document.getElementById('sa-dialog');
        var cartEl = document.getElementById('sa-cart');
        var emptyEl = document.getElementById('sa-empty');
        var customer = document.getElementById('sa-customer');
        var method = document.getElementById('sa-method');
        var disc = document.getElementById('sa-disc');
        var msgs = document.getElementById('sa-msgs');
        var confirmBtn = document.getElementById('sa-confirm');
        var items = [];

        function money(n) { return '৳' + n.toLocaleString('en-IN', { maximumFractionDigits: 2 }); }

        function recalc() {
            var notes = [], blocked = false, subtotal = 0;

            items.forEach(function (it) {
                var qty = parseInt(it.qtyInput.value, 10) || 1;
                if (qty > it.stock) {
                    qty = it.stock;
                    it.qtyInput.value = qty;
                    notes.push({ t: 'Only ' + it.stock + ' of ' + it.name + ' in stock.' });
                }
                if (qty < 1) { qty = 1; it.qtyInput.value = 1; }
                var price = parseFloat(it.priceInput.value) || 0;
                it.qty = qty; it.price = price;
                subtotal += qty * price;
                if (price < it.cost) {
                    notes.push({ t: it.name + ' is priced below cost (' + money(it.cost) + '). Manager approval is needed.' });
                }
            });

            var d = Math.min(Math.max(parseFloat(disc.value) || 0, 0), 100);
            var discAmt = Math.round(subtotal * d) / 100;
            var total = subtotal - discAmt;
            if (d > 10) { notes.push({ t: 'Discounts over 10% need Manager approval.' }); }

            if (method.value === 'credit' && items.length) {
                var opt = customer.options[customer.selectedIndex];
                var limit = parseFloat(opt.dataset.limit), due = parseFloat(opt.dataset.due);
                if (!customer.value && customer.selectedIndex === 0) {
                    notes.push({ t: 'Choose a customer for a credit sale.', b: true }); blocked = true;
                } else if (due + total > limit) {
                    notes.push({ t: 'This sale would take ' + opt.text + ' over their credit limit of ' + money(limit) + ' (they already owe ' + money(due) + ').', b: true });
                    blocked = true;
                } else {
                    notes.push({ t: 'The full amount will be added to ' + opt.text + "'s due balance." });
                }
            }

            document.getElementById('sa-sub').textContent = money(subtotal);
            document.getElementById('sa-disc-amt').textContent = discAmt ? '−' + money(discAmt) : money(0);
            document.getElementById('sa-total').textContent = money(total);
            emptyEl.style.display = items.length ? 'none' : '';

            msgs.innerHTML = '';
            notes.forEach(function (n) {
                var li = document.createElement('li');
                li.textContent = n.t;
                if (n.b) { li.className = 'sa-blocked'; }
                msgs.appendChild(li);
            });
            confirmBtn.disabled = blocked || !items.length;
        }

        function addItem(btn) {
            var name = btn.dataset.name;
            var found = items.filter(function (i) { return i.name === name; })[0];
            if (found) { found.qtyInput.value = (parseInt(found.qtyInput.value, 10) || 0) + 1; recalc(); return; }

            var row = document.createElement('div');
            row.className = 'sa-line';
            row.innerHTML = '<b></b><input type="number" min="1" value="1" aria-label="Quantity"><input type="number" min="0" step="0.01" aria-label="Unit price"><button type="button" class="sa-remove" aria-label="Remove">×</button>';
            row.firstChild.textContent = name;
            var inputs = row.querySelectorAll('input');
            inputs[1].value = btn.dataset.price;

            var it = { name: name, cost: parseFloat(btn.dataset.cost), stock: parseInt(btn.dataset.stock, 10), qtyInput: inputs[0], priceInput: inputs[1], row: row };
            items.push(it);
            row.addEventListener('input', recalc);
            row.querySelector('.sa-remove').addEventListener('click', function () {
                items.splice(items.indexOf(it), 1); row.remove(); recalc();
            });
            cartEl.appendChild(row);
            recalc();
        }

        document.querySelectorAll('.sa-prod').forEach(function (b) {
            b.addEventListener('click', function () { addItem(b); });
        });

        document.getElementById('sa-find').addEventListener('input', function (e) {
            var q = e.target.value.toLowerCase();
            document.querySelectorAll('.sa-prod').forEach(function (b) {
                b.style.display = b.dataset.name.toLowerCase().indexOf(q) > -1 ? '' : 'none';
            });
        });

        [customer, method, disc].forEach(function (el) { el.addEventListener('input', recalc); });

        document.getElementById('sa-new').addEventListener('click', function () {
            items.forEach(function (i) { i.row.remove(); });
            items = [];
            customer.selectedIndex = 0; method.value = 'cash'; disc.value = 0;
            document.getElementById('sa-find').value = '';
            document.querySelectorAll('.sa-prod').forEach(function (b) { b.style.display = ''; });
            recalc();
            dlg.showModal();
        });
    })();
</script>
