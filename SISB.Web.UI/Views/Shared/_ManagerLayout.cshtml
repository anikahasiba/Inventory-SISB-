@*
    Views/Shared/_ManagerLayout.cshtml
    Same look as _PrivateLayout, but the menu is built only from the Manager row in SRS section 2.3:
    "Products, purchases, receive goods (GRN), record and approve adjustments,
     approve stock counts, reports, AI features".
    Anything not in that list (Suppliers, Customers, Sales, Categories, Users, Audit Log, Settings)
    is left out. See the commented-out links below if you decide to allow some of them.
*@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool Is(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase);
    bool IsAction(string name) => string.Equals(action, name, StringComparison.OrdinalIgnoreCase);

    var fullName = User.Identity?.Name ?? "Manager";
    var initial = fullName.Substring(0, 1).ToUpper();

    // Optional: set ViewData["PendingApprovals"] in the controller to show a number on the bell.
    var pending = ViewData["PendingApprovals"] as int? ?? 0;

    // Optional: adjustments and stock counts waiting for this Manager (shown next to the menu link).
    var pendingStock = ViewData["PendingStockApprovals"] as int? ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | SmartStock Manager</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: #f5f7fb;
            font-family: 'Segoe UI', sans-serif;
            color: #253047;
        }

        .skip-link {
            position: absolute;
            left: -9999px;
            top: 8px;
            background: #fff;
            color: #17243a;
            padding: 8px 14px;
            border-radius: 8px;
            z-index: 100;
        }
        .skip-link:focus { left: 8px; }

        /* ---------- sidebar ---------- */
        .sidebar {
            width: 250px;
            background: #17243a;
            color: #fff;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            padding: 24px 16px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .brand { font-size: 23px; font-weight: 750; padding: 5px 12px 4px; }
        .brand span { color: #45d6a0; }
        .role-tag {
            display: inline-block;
            margin: 0 12px 22px;
            font-size: 12px;
            font-weight: 600;
            color: #45d6a0;
            background: rgba(69, 214, 160, .12);
            border-radius: 20px;
            padding: 2px 10px;
        }

        .menu-title { color: #8d9bb1; font-size: 11px; font-weight: 700; margin: 20px 12px 10px; letter-spacing: 1px; }

        .sidebar a.nav-item {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 12px;
            margin: 4px 0;
            border-radius: 8px;
            color: #bdc9d9;
            text-decoration: none;
            font-size: 14px;
        }
        .sidebar a.nav-item:hover,
        .sidebar a.nav-item.active { background: #263b55; color: #fff; }
        .sidebar a.nav-item.active { border-left: 3px solid #45d6a0; }
        .sidebar a.nav-item:focus-visible { outline: 2px solid #45d6a0; outline-offset: 2px; }

        .nav-badge {
            margin-left: auto;
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            border-radius: 20px;
            background: #dc4545;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            display: grid;
            place-items: center;
        }

        .signout { margin-top: auto; padding-top: 18px; }
        .signout button {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 12px;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: #bdc9d9;
            font-size: 14px;
            text-align: left;
        }
        .signout button:hover { background: #263b55; color: #fff; }

        /* ---------- main ---------- */
        .main { margin-left: 250px; padding: 25px 30px; }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            gap: 15px;
        }
        .topbar h4 { font-weight: 700; margin: 0; }

        .profile { display: flex; align-items: center; gap: 10px; }
        .bell { position: relative; color: #253047; text-decoration: none; font-size: 20px; margin-right: 8px; }
        .bell .count {
            position: absolute;
            top: -6px;
            right: -9px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 20px;
            background: #dc4545;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            display: grid;
            place-items: center;
        }
        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #d9f5e9;
            color: #159568;
            display: grid;
            place-items: center;
            font-weight: 700;
        }

        footer { text-align: center; color: #778398; font-size: 13px; margin-top: 28px; }

        /* ---------- small screens ---------- */
        @@media (max-width: 900px) {
            .sidebar { width: 70px; padding: 20px 8px; }
            .brand { font-size: 0; padding: 5px 10px 4px; }
            .brand span { font-size: 22px; }
            .role-tag { display: none; }
            .menu-title { display: none; }
            .nav-badge { display: none; }
            .sidebar a.nav-item,
            .signout button { justify-content: center; font-size: 0; }
            .sidebar a.nav-item i,
            .signout button i { font-size: 19px; }
            .main { margin-left: 70px; padding: 20px 14px; }
        }

        @@media (max-width: 550px) {
            .topbar { align-items: flex-start; }
            .profile .user-info { display: none; }
            .main { padding: 15px 10px; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- SIDEBAR: only what a Manager may use -->
    <aside class="sidebar">
        <div class="brand">Smart<span>Stock.</span></div>
        <div class="role-tag">Manager</div>

        <nav aria-label="Main menu">
            <div class="menu-title">MAIN MENU</div>
            <a href="/MDashboard/Index" class="nav-item @(Is("Dashboard") ? "active" : "")" title="Dashboard" aria-current="@(Is("Dashboard") ? "page" : null)"><i class="bi bi-grid"></i> Dashboard</a>

            <div class="menu-title">PRODUCTS</div>
            <a href="/MProduct/Index" class="nav-item @(Is("Product") ? "active" : "")" title="Products" aria-current="@(Is("Product") ? "page" : null)"><i class="bi bi-box-seam"></i> Products</a>

            <div class="menu-title">PURCHASING</div>
            <a href="/MPurchase/Index" class="nav-item @(Is("Purchase") && !IsAction("Receive") ? "active" : "")" title="Purchase Orders" aria-current="@(Is("Purchase") && !IsAction("Receive") ? "page" : null)"><i class="bi bi-cart-plus"></i> Purchase Orders</a>
            <a href="/MReceive/Index" class="nav-item @(Is("Purchase") && IsAction("Receive") ? "active" : "")" title="Receive Goods" aria-current="@(Is("Purchase") && IsAction("Receive") ? "page" : null)"><i class="bi bi-box-arrow-in-down"></i> Receive Goods</a>

            <div class="menu-title">STOCK</div>
            <a href="/MAdjustment/Index" class="nav-item @(Is("Stock") ? "active" : "")" title="Adjustments and Counts" aria-current="@(Is("Stock") ? "page" : null)">
                <i class="bi bi-clipboard-check"></i> Adjustments &amp; Counts
                @if (pendingStock > 0)
                {
                    <span class="nav-badge" aria-label="@pendingStock waiting for approval">@pendingStock</span>
                }
            </a>

            <div class="menu-title">REPORTS &amp; AI</div>
            <a href="/MReport/Index" class="nav-item @(Is("Report") ? "active" : "")" title="Reports" aria-current="@(Is("Report") ? "page" : null)"><i class="bi bi-bar-chart"></i> Reports</a>
            <a href="/MForecast/Index" class="nav-item @(Is("Forecast") ? "active" : "")" title="Smart Reorder" aria-current="@(Is("Forecast") ? "page" : null)"><i class="bi bi-graph-up-arrow"></i> Smart Reorder</a>
            <a href="/MAssistant/Index" class="nav-item @(Is("Assistant") ? "active" : "")" title="AI Assistant" aria-current="@(Is("Assistant") ? "page" : null)"><i class="bi bi-robot"></i> AI Assistant</a>

            @*
                Not in the Manager row of SRS 2.3, so they are left out. Un-comment a line only if you decide to allow it:

                <a href="/Category/Index" class="nav-item"><i class="bi bi-tags"></i> Categories</a>
                <a href="/Supplier/Index" class="nav-item"><i class="bi bi-truck"></i> Suppliers</a>
                <a href="/Customer/Index" class="nav-item"><i class="bi bi-people"></i> Customers</a>
                <a href="/Sales/Index"    class="nav-item"><i class="bi bi-receipt"></i> Sales</a>
            *@
        </nav>

        <form class="signout" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" title="Sign out"><i class="bi bi-box-arrow-right"></i> Sign out</button>
        </form>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main" id="main-content">

        <div class="topbar">
            <div>
                <h4>@ViewData["Title"]</h4>
                @if (ViewData["Subtitle"] != null)
                {
                    <small class="text-secondary">@ViewData["Subtitle"]</small>
                }
            </div>
            <div class="profile">
                <a class="bell" href="/Dashboard/Manager#md-approvals" aria-label="@(pending > 0 ? pending + " requests waiting for approval" : "No requests waiting")">
                    <i class="bi bi-bell"></i>
                    @if (pending > 0)
                    {
                        <span class="count">@pending</span>
                    }
                </a>
                <div class="avatar" aria-hidden="true">@initial</div>
                <div class="user-info">
                    <strong class="d-block small">@fullName</strong>
                    <small class="text-secondary">Manager</small>
                </div>
            </div>
        </div>

        @RenderBody()

        <footer>© 2026 SmartStock. All Rights Reserved.</footer>
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
